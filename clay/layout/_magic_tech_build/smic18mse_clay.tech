# Auto-generated minimal Magic techfile for parasitic extraction.
# PDK: smic18mse
# Generated by clay.layout.magic_tech_gen from the PDK's OWN data:
#   cifinput GDS numbers  <- clay.frontend.pdk_layermap.parse_layermap
#   cap coefficients      <- clay.layout.pex.pdk_constants.resolve_pdk_pex_constants
# This is a Magic 2.5D extraction from a Clay-generated tech with REAL
# per-PDK constants; NOT the foundry signed StarRC/QRC ITF deck.

tech
 format 35
 smic18mse_clay
end

planes
  well,w
  active,a
  poly,p
  metal1,m1
  metal2,m2
end

types
  well nwell
  active ndiff
  poly poly
  metal1 contact
  metal1 metal1
  metal2 via1
end

contact
end

styles
 styletype mos
  nwell nwell
  ndiff ndiffusion
  poly polysilicon
  contact metal1
  metal1 metal1
  via1 metal2
end

compose
end

connect
  metal1 metal1
  poly poly
  ndiff ndiff
  contact contact
  via1 via1
end

cifoutput
style gdsii
 scalefactor 1 nanometers
 gridlimit 1

 layer NWELL nwell
	calma 14 0

 layer DIFF ndiff
	calma 10 0

 layer POLY poly
	calma 30 0

 layer CONTACT contact
	calma 50 0

 layer METAL1 metal1
	calma 61 0

 layer VIA1 via1
	calma 70 0
end

cifinput
style import
 scalefactor 1 nanometers
 gridlimit 1
 options ignore-unknown-layer-labels

 layer nwell NWELL
 layer ndiff DIFF
 layer poly POLY
 layer contact CONTACT
 layer metal1 METAL1
 layer via1 VIA1

 calma NWELL 14 0
 calma DIFF 10 0
 calma POLY 30 0
 calma CONTACT 50 0
 calma METAL1 61 0
 calma VIA1 70 0
end

drc
end

extract
 style ngspice
 cscale 1
 lambda 1.0
 units microns
 step 4
 sidehalo 8
 fringeshieldhalo 8

 planeorder well 0
 planeorder active 1
 planeorder poly 2
 planeorder metal1 3
 planeorder metal2 4

 defaultareacap   poly active 0.0448
 defaultperimeter poly active 0.1994
 defaultsidewall  poly active 0.1994

 defaultareacap   metal1 metal1 0.0448
 defaultperimeter metal1 metal1 0.1994
 defaultsidewall  metal1 metal1 0.1994

 defaultoverlap     metal1 metal1 poly active 0.0448
 defaultsideoverlap metal1 metal1 poly active 0.1994

end
