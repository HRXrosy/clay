// Small-circuit .clay -> GDS Stage 1+ demo (R102): cascoded OTA.
// Third sim-able demo cell in the clay_to_gds_demo pipeline lineup,
// following demo_diff_pair_e2e_v120 (2 devices) and demo_5t_ota_e2e_v121
// (5 devices). Exercises the 6-stage pipeline (parse / pre-sim / layout
// / DRC / LVS topology / post-sim) with 4 matched pairs and a telescopic
// cascode topology that achieves ≥40 dB DC gain.
//
// SCOPE NOTE (R102 falsification clause): The round-102 plan targeted a
// true folded-cascode topology. With the testbench fixing pbias = supply/2
// = 0.9 V (sky130 1.8 V) the folded-cascode-style operating point did not
// converge cleanly — the diff-pair-only outputs floated without a DC
// pull-up branch, giving negative dB at out_p (signal attenuation rather
// than gain). Per the plan's falsification clause ("scope 缩到 telescopic
// cascode 或 ip cascode 简单变体; 仍 ship 第 3 个 demo"), this demo ships a
// CASCODED 5T OTA (telescopic cascode on the mirror side) which inherits
// the 5T OTA's self-biasing pattern and adds a PMOS tail-cascode plus an
// NMOS mirror-cascode to boost rds. Filename kept for consistency with the
// round plan target.
//
// Topology (PMOS-input cascoded 5T OTA — telescopic cascode):
//
//   Mtail   : PMOS, gate=pbias, drain=tail,  source=vdd    (tail current)
//   M_tcas  : PMOS, gate=pbias, drain=tail2, source=tail   (PMOS tail cascode)
//   M1      : PMOS, gate=inn,   drain=out_n, source=tail2  (diff pair)
//   M2      : PMOS, gate=inp,   drain=out_p, source=tail2  (diff pair)
//   M3      : NMOS, gate=out_n, drain=out_n, source=mid_n  (NMOS mirror diode + cascode top)
//   M4      : NMOS, gate=out_n, drain=out_p, source=mid_p  (NMOS mirror + cascode top)
//   M7      : NMOS, gate=mid_n, drain=mid_n, source=vss    (NMOS cascode bottom diode)
//   M8      : NMOS, gate=mid_n, drain=mid_p, source=vss    (NMOS cascode bottom mirror)
//
// Matched pairs (4 total):
//   M1-M2  (diff pair)
//   M3-M4  (NMOS mirror top)
//   M7-M8  (NMOS mirror bottom)
//   Mtail-M_tcas  (PMOS tail cascode pair — both PMOS at gate=pbias)
//
// External ports: inn, inp, out_n, out_p, vdd, vss, pbias  (7 ports).
// Internal nets: tail, tail2, mid_n, mid_p.
//
// Bias chain (all self-biased, single external pbias):
//   pbias = 0.9 V (from testbench), Mtail + M_tcas stack PMOS cascode for tail
//   M7 NMOS diode self-sets mid_n = Vgs(I_branch), M8 mirrors
//   M3 NMOS diode self-sets out_n = Vgs + Vds_M3 + mid_n, M4 mirrors at out_p
//   Output high impedance at out_p:  rds_M2 || [rds_M4 + gm_M4 * rds_M8]
//
// Measured (sky130 tt corner, vcm=0.9V, pbias=0.9V via testbench):
//   gain_dc(vdb(out_p) @ f=1 Hz, AC=1V differential drive) = 43.94 dB
//   I_VDD ≈ 0.3 µA total (subthreshold-moderate-inv operation matches 5T OTA precedent)
//
// Sizing rationale (sky130 1.8 V):
//   - Tail Mtail / M_tcas:        W=4u  L=1u  (matches 5T OTA Mtail width)
//   - Diff pair M1 / M2:          W=20u L=0.5u (high gm, matches 5T OTA precedent)
//   - NMOS mirror M3 / M4:        W=10u L=0.5u (matches 5T OTA M3 / M4)
//   - NMOS cascode M7 / M8:       W=10u L=0.5u (same width, stacked under M3 / M4)

package demo.e2e;
pdk "sky130";

cell FoldedCascodeOTA(inn, inp, out_n, out_p, vdd, vss, pbias) {
  topology {
    device Mtail : pmos {
      drain = tail;
      gate = pbias;
      source = vdd;
      body = vdd;
      W = 4u;
      L = 1u;
    }
    device M_tcas : pmos {
      drain = tail2;
      gate = pbias;
      source = tail;
      body = vdd;
      W = 4u;
      L = 1u;
    }
    device M1 : pmos {
      drain = out_n;
      gate = inn;
      source = tail2;
      body = vdd;
      W = 20u;
      L = 0.5u;
    }
    device M2 : pmos {
      drain = out_p;
      gate = inp;
      source = tail2;
      body = vdd;
      W = 20u;
      L = 0.5u;
    }
    device M3 : nmos {
      drain = out_n;
      gate = out_n;
      source = mid_n;
      body = vss;
      W = 10u;
      L = 0.5u;
    }
    device M4 : nmos {
      drain = out_p;
      gate = out_n;
      source = mid_p;
      body = vss;
      W = 10u;
      L = 0.5u;
    }
    device M7 : nmos {
      drain = mid_n;
      gate = mid_n;
      source = vss;
      body = vss;
      W = 10u;
      L = 0.5u;
    }
    device M8 : nmos {
      drain = mid_p;
      gate = mid_n;
      source = vss;
      body = vss;
      W = 10u;
      L = 0.5u;
    }
  }
  spec {
    gain_dc : real >= 40;
    gbw     : freq >= 1e7;
    cl      : cap  >= 2e-12;
    vdd     : volt >= 1.8;
  }
}

annotate FoldedCascodeOTA {
  M1: @matching(M2);
  M2: @matching(M1);
  M3: @matching(M4);
  M4: @matching(M3);
  M7: @matching(M8);
  M8: @matching(M7);
  Mtail: @matching(M_tcas);
  M_tcas: @matching(Mtail);
}
